# Para correr en local con `npm run dev` (copia a .env)
PUERTO=4004
DATABASE_URL=postgresql://inventario:plaza-db-clave@localhost:5435/inventario
RABBITMQ_URL=amqp://plaza:plaza@localhost:5672
JWT_SECRET=cambia-esto-por-un-secreto-largo
CLAVE_INTERNA=clave-interna-dev
SEED_DEMO=true
LOG_LEVEL=info
# Opcional: activa la prueba de concurrencia contra Postgres real
# DATABASE_URL_PRUEBAS=postgresql://inventario:plaza-db-clave@localhost:5435/inventario
