generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id             String      @id @default(uuid())
  codigo         String      @unique
  clienteId      String
  clienteNombre  String
  clienteEmail   String?
  estado         String
  total          Int
  unidades       Int
  direccion      Json
  idempotencyKey String
  reservaId      String?
  correlationId  String
  motivo         String?
  creadoEn       DateTime    @default(now())
  actualizadoEn  DateTime    @updatedAt
  subpedidos     SubPedido[]
  pagos          Pago[]
  pasos          PasoTraza[]

  @@unique([clienteId, idempotencyKey])
  @@index([clienteId])
}

model SubPedido {
  id                String       @id @default(uuid())
  pedidoId          String
  vendedorId        String
  vendedorUsuarioId String
  nombreTienda      String
  estado            String
  subtotal          Int
  unidades          Int
  actualizadoEn     DateTime     @updatedAt
  pedido            Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  items             ItemPedido[]

  @@index([vendedorUsuarioId])
}

model ItemPedido {
  id             String    @id @default(uuid())
  subPedidoId    String
  productoId     String
  nombre         String
  categoria      String?
  imagen         String?
  precioUnitario Int
  cantidad       Int
  subtotal       Int
  subPedido      SubPedido @relation(fields: [subPedidoId], references: [id], onDelete: Cascade)
}

model Pago {
  id         String   @id @default(uuid())
  pedidoId   String
  estado     String
  marca      String
  ultimos4   String
  titular    String
  monto      Int
  referencia String
  motivo     String?
  creadoEn   DateTime @default(now())
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model PasoTraza {
  id            String   @id @default(uuid())
  pedidoId      String
  servicio      String
  accion        String
  detalle       String?
  via           String
  correlationId String?
  ocurridoEn    DateTime @default(now())
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}

model Contador {
  nombre String @id
  valor  Int
}

model EventoProcesado {
  id         String   @id
  tipo       String
  procesadoEn DateTime @default(now())
}
