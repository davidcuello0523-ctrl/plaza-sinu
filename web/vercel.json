{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "http://184.195.91.251:8080/:ruta*" },
    { "source": "/docs/:ruta*", "destination": "http://184.195.91.251:8080/docs/:ruta*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
